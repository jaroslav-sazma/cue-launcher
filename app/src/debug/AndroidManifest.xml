<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: the bridge's fixture notifications. Requested just in time from the
         bridge screen's buttons; the adb path posts nothing until they are granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <!-- No app a user installs can hold DUMP and the shell does, so only adb sends this. -->
        <receiver
            android:name="app.cue.launcher.debug.bridge.BridgeFixtureReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name="app.cue.launcher.debug.bridge.BridgeFixtureReplyReceiver"
            android:exported="false" />
    </application>
</manifest>
